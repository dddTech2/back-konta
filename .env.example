# ==============================================================================
# CONFIGURACIÓN AUTOMATIZACIÓN DIAN VPFE
# ==============================================================================

# Modalidad de ingreso por defecto: 'persona' o 'empresa'
DIAN_LOGIN_TYPE=persona

# URLs del Portal DIAN (Habilitación o Producción)
# Habilitación:
DIAN_URL=https://catalogo-vpfe-hab.dian.gov.co/User/PersonLogin
DIAN_COMPANY_URL=https://catalogo-vpfe-hab.dian.gov.co/User/CompanyLogin
# Producción (descomentar si se usa directamente en producción):
# DIAN_URL=https://catalogo-vpfe.dian.gov.co/User/PersonLogin
# DIAN_COMPANY_URL=https://catalogo-vpfe.dian.gov.co/User/CompanyLogin

# ------------------------------------------------------------------------------
# Credenciales del Contribuyente / Empresa
# ------------------------------------------------------------------------------
# Modo Persona Natural: Cédula de Ciudadanía
DIAN_PERSON_CODE=1000000001

# Modo Empresa: Cédula del Representante Legal y NIT de la Empresa (sin DV)
DIAN_REPRESENTATIVE_CODE=10000002
DIAN_COMPANY_NIT=901008579

# ------------------------------------------------------------------------------
# Servidor de Correo Stalwart (Recepción automática del token mágico)
# ------------------------------------------------------------------------------
STALWART_IMAP_HOST=mail.example.com
STALWART_IMAP_PORT=993
STALWART_USER=token@example.com
STALWART_PASSWORD=tu_contrasena_aqui

# ------------------------------------------------------------------------------
# Opciones de Ejecución y Descarga
# ------------------------------------------------------------------------------
# Ejecución visible o segundo plano (False recomendado para evitar bloqueos)
HEADLESS=False

# Tiempo máximo de espera para la llegada del correo con el token (segundos)
EMAIL_TIMEOUT_SECONDS=60

# Tiempo máximo de espera para que la DIAN procese y ponga en 'Listo' el ZIP (segundos)
EXPORT_DOWNLOAD_TIMEOUT_SECONDS=300

# Segundos que un trabajo puede seguir en PROCESSING sin respuesta antes de darlo por atascado y
# reintentarlo a las 6 h. Vacío = EXPORT_DOWNLOAD_TIMEOUT_SECONDS + 600.
STALE_PROCESSING_SECONDS=

# Programador semanal de descargas (proceso `scheduler`, en el servidor). Solo 'true' lo activa;
# mientras el worker remoto no arranque solo y su latido no se vea (docs/DEPLOYMENT.md, sección 7) déjalo en false.
SCHEDULER_ENABLED=false
# Día de la corrida semanal: 0 = lunes ... 6 = domingo (por defecto 6, domingo)
SCHEDULER_WEEKDAY=6
# Hora de la corrida en America/Bogota, 0 a 23 (por defecto 3, las 03:00)
SCHEDULER_HOUR=3

# Carpeta de destino de los archivos ZIP descargados
DOWNLOAD_DIR=./downloads

# ==============================================================================
# BOT DE TELEGRAM
# ==============================================================================
# Token del bot único (creado con @BotFather). Usado también para alertas de Tech Ops.
TELEGRAM_BOT_TOKEN=

# Chat ID de Katerinn (Administradora Comercial). Al configurarlo:
# 1) se auto-vincula como ADMIN si escribe desde ese chat, y
# 2) autoriza a ese chat para auto-asignarse el rol de administración con /hacerme_admin.
# Por seguridad por defecto, /hacerme_admin queda deshabilitado si esta variable
# y ADMIN_BOOTSTRAP_CHAT_IDS están vacías.
ADMIN_TELEGRAM_CHAT_ID=

# Alternativa/adicional a ADMIN_TELEGRAM_CHAT_ID: lista de chat_id autorizados a usar
# /hacerme_admin, separados por coma. Solo los chats listados aquí o en
# ADMIN_TELEGRAM_CHAT_ID podrán activar privilegios de administración.
ADMIN_BOOTSTRAP_CHAT_IDS=

# ==============================================================================
# FRONTEND WEB/MÓVIL (front-konta)
# ==============================================================================
# Carpeta con la SPA compilada (`npm ci && npm run build` en front-konta genera `dist/`) que la
# API monta en /app. `dist/` no se commitea: constrúyela antes de arrancar la API o `docker compose up`.
# En Docker esta ruta es la de la carpeta dist en el servidor (relativa a docker-compose.yml) y se monta en /frontend/dist. No lo dejes vacío: la carpeta ProyectoDianFront
# sin compilar contiene el index.html de Vite (que no funciona sin build) y el código fuente.
FRONTEND_DIR=../front-konta/dist

# URL pública de la SPA que el bot de Telegram envía al cliente (?nit=<nit> se agrega
# automáticamente y la SPA lo ignora: el acceso es por OTP). En producción debe ser el dominio real,
# no 127.0.0.1. Si tu .env ya tenía la URL del prototipo (.../app/kontable-prototipo_1.html), cámbiala
# a .../app/: el build de la SPA no incluye ese archivo y el enlace antiguo daría 404.
KONTABLE_WEB_URL=http://127.0.0.1:8000/app/

# ==============================================================================
# WORKER REMOTO (extracción DIAN corriendo fuera del VPS, ej. en tu red de casa)
# ==============================================================================
# Contraseña del contenedor Redis en el VPS (docker-compose.yml la usa via --requirepass).
REDIS_PASSWORD=cambia_esto_por_algo_largo_y_aleatorio

# Cómo se conecta CADA PROCESO a Redis:
#   - api, bot, scheduler y worker local (contenedores en el VPS): docker-compose.yml fija su REDIS_URL a
#     redis://...@redis:6379 (dentro de la red de compose el host es "redis"); este valor no les aplica.
#   - Fuera de docker (`uv run ...` en tu equipo con Redis local): usa localhost, como abajo.
#   - kontable-worker-remote (en tu casa): usa la IP/dominio público del VPS y el puerto
#     publicado (6390 por defecto en docker-compose.yml).
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# Secreto compartido entre la API (VPS) y kontable-worker-remote (casa) para los endpoints
# /internal/jobs/*. Genera uno único, ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_WORKER_TOKEN=

# ==============================================================================
# AUTENTICACIÓN WEB (login por código OTP enviado por Telegram -> JWT)
# ==============================================================================
# Secreto que firma el JWT y el hash de los códigos OTP. Obligatorio para iniciar sesión en la
# web; genera uno único, ej.: python -c "import secrets; print(secrets.token_urlsafe(48))".
# Cambiarlo invalida todas las sesiones y los códigos pendientes.
JWT_SECRET=
# Vigencia del JWT en minutos (sin refresh; al expirar el usuario pide un código nuevo).
JWT_TTL_MINUTES=60

# Solo lo usa kontable-worker-remote: URL pública de la API en el VPS (usa el puerto real,
# ej. 8020 si así lo dejaste en docker-compose.yml).
KONTABLE_API_URL=http://<ip-o-dominio-del-vps>:8020

# Solo lo usa kontable-worker-remote: nombre con el que se identifica en el latido (por defecto remote).
WORKER_NAME=remote
# Solo lo usa kontable-worker-remote: carpeta donde deja los ZIP que no pudo subir para reintentarlos
# (por defecto pending_uploads/ en el directorio de trabajo).
PENDING_UPLOADS_DIR=
# Lo lee el proceso `scheduler` (servidor): minutos sin latido del worker, con trabajos listos,
# antes de avisar por Telegram a TECH_OPS y ADMIN (por defecto 15).
WORKER_SILENCE_MINUTES=15

# Calendario tributario (API y bot): días de antelación desde los que una obligación se marca
# "próxima" (por defecto 15).
CALENDAR_UPCOMING_DAYS=15

# ==============================================================================
# BASE DE DATOS (PostgreSQL)
# ==============================================================================
# Contraseña para el usuario 'kontable' en el contenedor PostgreSQL (servicio postgres).
# Genera una clave aleatoria larga, ej.: openssl rand -hex 24
# Usa solo letras y números (hexadecimal) para que la URL de conexión no requiera escapes de caracteres especiales.
POSTGRES_PASSWORD=cambia_esto_por_una_clave_hex_larga

# Retención y frecuencia de las copias de seguridad automáticas (servicio backup en docker-compose)
# BACKUP_KEEP_DAYS=14
# BACKUP_INTERVAL_HOURS=24

# ==============================================================================
# BASE DE DATOS Y MIGRACIONES (Alembic)
# ==============================================================================
# URL SQLAlchemy de la base, la misma para la app y para Alembic.
# En Docker, docker-compose.yml fija DATABASE_URL hacia el servicio postgres (este valor no aplica a los contenedores).
# En desarrollo el valor por defecto sigue siendo SQLite.
# Para probar PostgreSQL fuera de Docker se usa postgresql+psycopg://usuario:clave@host:5432/base.
# Alembic es dueño del esquema: bot y worker NO crean tablas al arrancar. En un despliegue
# nuevo ejecuta `uv run alembic upgrade head` antes de iniciarlos; una base ya creada con
# create_all se adopta con `alembic stamp 0001` + `alembic upgrade head` (ver docs/ENVIRONMENT.md).
# DATABASE_URL=sqlite:///./kontable.db
